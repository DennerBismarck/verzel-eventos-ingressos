# Copie para .env e ajuste. O .env NÃO vai pro git (ver .gitignore).

# Chave do Django (sessões, CSRF, etc.). Em produção, gere uma nova e longa.
SECRET_KEY=dev-inseguro-troque-em-producao

# Chave usada só para assinar o QR do ingresso (HMAC).
# Separada da SECRET_KEY de propósito: se um dia a SECRET_KEY vazar/rotacionar,
# os ingressos já emitidos não viram inválidos — e vice-versa.
TICKET_SIGNING_KEY=dev-chave-de-assinatura-do-ingresso

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres do docker-compose.yml (host 5433 -> container 5432)
DATABASE_URL=postgres://ingressos:ingressos@localhost:5433/ingressos

# Origens do front que podem chamar a API (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:3100,http://127.0.0.1:3100

# API externa de catálogo — a chave fica AQUI, no backend, nunca no front.
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR
TICKETMASTER_API_KEY=
